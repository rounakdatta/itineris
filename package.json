{
  "name": "itineris",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.sw.config.js",
    "preview": "vite preview",
    "seed": "node scripts/make-seed.js",
    "build:admin": "vite build -c vite.admin.config.js && vite build -c vite.admin-sw.config.js",
    "dev:admin": "vite -c vite.admin.config.js",
    "server": "node server/index.js",
    "test:server": "node scripts/test-server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/make-seed.js",
    "prebuild": "node scripts/make-seed.js",
    "predev:admin": "node scripts/make-seed.js",
    "prebuild:admin": "node scripts/make-seed.js",
    "pretest:server": "node scripts/make-seed.js",
    "preserver": "node scripts/make-seed.js",
    "test:e2e": "node scripts/e2e.mjs",
    "shot:live": "node scripts/shot-live.mjs",
    "check:live": "node scripts/check-live-offline.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "piexifjs": "^1.0.6",
    "puppeteer-core": "^24.43.1",
    "svelte": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "exifr": "^7.1.3",
    "hono": "^4.13.7",
    "maplibre-gl": "^5.0.0",
    "sharp": "^0.35.4",
    "tz-lookup": "^6.1.25"
  }
